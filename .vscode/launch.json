{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Blog API (Docker)",
      "type": "debugpy",
      "request": "attach",
      "preLaunchTask": "Start debug Compose",
      "postDebugTask": "Stop debug Compose",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/app"
        }
      ],
      "subProcess": true,
      "justMyCode": true
    }
  ]
}
