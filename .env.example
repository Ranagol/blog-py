# Copy this file to .env and change the local-only passwords and secret.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_DB=postgres

DB_PASSWORD=local-app-password
TEST_DB_PASSWORD=local-test-password

DATABASE_URL=postgresql+psycopg://blog_app:local-app-password@database:5432/blog_dev
TEST_DATABASE_URL=postgresql+psycopg://blog_test:local-test-password@database:5432/blog_test

SECRET_KEY=CHANGE-ME-TO-A-32-CHAR-RANDOM-SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_PORT=8000

# Tracefox is open in local development. Use production and set credentials
# before exposing the dashboard outside your local machine.
TRACEFOX_ENV=local
# TRACEFOX_USERNAME=
# TRACEFOX_PASSWORD=

# Set these to the output of `id -u` and `id -g` on the host.
HOST_UID=1000
HOST_GID=1000
